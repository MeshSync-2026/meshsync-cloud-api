# MeshSync Cloud API — environment template
# Local:  cp .env.example .env   → fill values →  npm run dev:edge  /  npm run dev:cc
# Render: set these per service in the Render dashboard (Environment tab). Never commit .env.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development

# ── Database (both services) ─────────────────────────────
# Supabase → Connect → Session pooler URI (IPv4-compatible, port 5432)
DATABASE_URL=postgres://meshsync:meshsync_dev_password@localhost:5432/meshsync

# ── Edge Sync service ────────────────────────────────────
EDGE_SYNC_PORT=4001
# Browser origin allowed to call Edge Sync (dashboard URL, e.g. https://meshsync-command-center.pages.dev). * = any (dev only)
CORS_ORIGIN=*
# Run migrations/001_initial_schema.sql on startup. Set true on Edge Sync ONLY, false on Command Center.
RUN_MIGRATIONS=true

# ── Command Center service ───────────────────────────────
CC_PORT=4002
# Public URL of the Edge Sync service (used for dispatch → ASSIGN events)
EDGE_SYNC_URL=http://localhost:4001

# ── Secrets ──────────────────────────────────────────────
# Command Center only
SESSION_SECRET=change-me-generate-32-random-bytes
# MUST be identical on BOTH services
INTERNAL_API_SECRET=change-me-generate-32-random-bytes
