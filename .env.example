# Environment Configuration for MeshSync Microservices

NODE_ENV=production

# Database Configuration
DATABASE_URL=postgres://meshsync:meshsync_secure_password@localhost:5432/meshsync

# Edge Sync Service
EDGE_SYNC_PORT=4001
EDGE_SYNC_INTERNAL_PORT=8080

# Command Center Service
CC_PORT=4002
EDGE_SYNC_URL=http://localhost:4001

# Security Secrets
SESSION_SECRET=change-this-to-a-secure-random-32-byte-secret-key!
INTERNAL_API_SECRET=change-this-to-a-secure-internal-microservice-token!
