{
  "name": "meshsync-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/edge-sync",
    "packages/command-center"
  ],
  "scripts": {
    "test": "node --test packages/shared/src/*.test.js packages/edge-sync/tests/*.test.js packages/command-center/tests/*.test.js",
    "test:shared": "node --test packages/shared/src/*.test.js",
    "test:edge": "node --test packages/edge-sync/tests/*.test.js",
    "test:cc": "node --test packages/command-center/tests/*.test.js",
    "start:edge": "node packages/edge-sync/src/server.js",
    "start:cc": "node packages/command-center/src/server.js"
  },
  "description": "The MeshSync backend is a Node.js application built using the two-service architecture described in Section 10.5 of the Architecture Plan.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeshSync-2026/meshsync-command-center.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MeshSync-2026/meshsync-command-center/issues"
  },
  "homepage": "https://github.com/MeshSync-2026/meshsync-command-center#readme"
}
